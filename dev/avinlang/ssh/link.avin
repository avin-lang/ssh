module dev.avinlang.ssh

// What a session and its commands share: the libssh2 session, its socket, the waits on it, and the
// state that says whether it may still be used. Only this module sees it.
import avin.net.ByteStream
import avin.time.{Duration, monotonic}

private class Link(
    val raw: RawSession,
    val socket: Socket,
    val host: string,
    val port: int,
    val options: Options
)
  var closed = false
  // Whether the release closes the descriptor: from the handshake on, the session holds it.
  var holdsSocket = false
  // Whether an operation stopped part-way, after which nothing can be sent on the session.
  var interrupted = false
  // Whether a wait is under way: a thread cancelled in one leaves it set, which marks the session
  // interrupted at its next use.
  var waiting = false
  // The channels of the commands open on the session, closed before it.
  val channels = Buffer[RawChannel]()
  // The SFTP subsystems open on the session, and the remote files open through them, closed before it.
  val sftps = Buffer[RawSftp]()
  val files = Buffer[RawSftpFile]()
  // Those of `channels` that are tunnels rather than commands.
  val tunnels = Buffer[RawChannel]()
  // The channels whose close is sent, waiting for the server's.
  val closing = Buffer[RawChannel]()
  // Whether the connection was cut, after which every libssh2 call fails at once.
  var cut = false
  // The user the server was asked about, and the methods it offers that user.
  var offered: Option[(string, Vector[string])] = None

  // Whether the session can be used: open, and no operation of it stopped part-way.
  isOpen -> bool = !closed && !interrupted && !waiting

  // `Ok` where the session can be used, checking first that it belongs to the code running.
  usable() -> Result[unit, SshError]
    if closed then return Err(Closed)
    noteCancelled()
    if interrupted then return Err(Interrupted)
    sweep()
    Ok(())

  // Checks the session belongs to the code running, and marks it interrupted where a wait of it never
  // finished.
  noteCancelled()
    _ = raw.blockDirections()
    if waiting
      interrupted = true
      waiting = false

  // Shakes hands with the server over the socket, which the session holds from then on.
  handshake() -> Result[unit, SshError]
    loop
      raw.handshake(socket.fd) match
        Ok(_) ->
          holdsSocket = true
          return Ok(())
        Err(code) ->
          // Nothing has reached the server but the connection, so every failure here, a reset
          // connection too, is a `Handshake`, safe to retry.
          if code != eagain then return Err(failure(code, "shake hands with the server") match
            Handshake(reason) -> Handshake(reason)
            other -> Handshake(other.message))
          await("shake hands with the server")?

  // Gives everything back at once, with nothing said to the server: for a session that failed before
  // it was handed out, or whose thread was cancelled while making it.
  abandon()
    if closed then return
    closed = true
    _ = raw.close()
    if !holdsSocket then _ = closeRaw(socket.fd)

  // Closes every remote file, SFTP subsystem and command still open, says goodbye to the server unless
  // the session was interrupted, and gives the session back. What could not be closed the protocol's
  // way is given back over the connection cut first, so that libssh2 frees it without waiting.
  close()
    if closed then return
    noteCancelled()
    closed = true
    for f in files.toArray() do _ = closeFile(f)
    for s in sftps.toArray() do endSftp(s)
    if interrupted then cutConnection()
    val open = channels.toArray()
    channels.clear()
    for ch in open do retire(ch)
    if !interrupted && holdsSocket
      _ = within("disconnect", options.closeTimeout, () -> raw.disconnect(disconnectByApplication, "closed by the client", ""))
    if files.nonEmpty || closing.nonEmpty
      cutConnection()
      for f in files.toArray()
        _ = f.closeHandle()
        _ = f.close()
      files.clear()
      for ch in closing.toArray() do _ = ch.close()
      closing.clear()
    for s in sftps.toArray() do _ = s.close()
    sftps.clear()
    _ = raw.close()

  // Shuts the connection down and makes the session blocking, so that every libssh2 call made after
  // fails at once with the socket's error, freeing what it would have freed on success.
  cutConnection()
    if cut || !holdsSocket then return
    cut = true
    _ = shutdownRaw(socket.fd, shutBoth)
    raw.setBlocking(1)

  // A new SFTP subsystem on the session.
  sftp() -> Result[RawSftp, SshError]
    loop
      raw.sftpInit() match
        Some(s) ->
          sftps.addOne(s)
          return Ok(s)
        None ->
          val code = raw.lastErrno()
          if code != eagain then return Err(failure(code, "start SFTP"))
          await("start SFTP")?

  // Closes the SFTP subsystem `s` the protocol's way, where the session can still talk and no file is
  // left open: libssh2 frees it then. One left open is freed with the session.
  endSftp(s: RawSftp)
    if interrupted || waiting || files.nonEmpty then return
    val rc = within("close SFTP", options.closeTimeout, () -> s.shutdown())
    if rc.isOk
      sftps.filterInPlace(x -> x !== s)
      _ = s.close()

  // Opens `path` through `s` with the SFTP open `flags`, made with `mode` where it is created.
  openFile(s: RawSftp, path: string, flags: int, mode: int) -> Result[RawSftpFile, SshError]
    loop
      s.open(path, long(path.byteLength), long(flags), long(mode), sftpOpenFile) match
        Some(f) ->
          files.addOne(f)
          return Ok(f)
        None ->
          val code = raw.lastErrno()
          if code != eagain then return Err(sftpFailure(s, code, path, "open"))
          await("open a remote file")?

  // Closes the remote file `f` the protocol's way, where the session can still talk, at most the
  // options' `closeTimeout`: `Ok` with what the close answered once libssh2 has freed it. A file whose
  // close was cut off stays listed, for the session's close to free.
  closeFile(f: RawSftpFile) -> Result[int, SshError]
    if interrupted || waiting then return Err(Interrupted)
    val rc = within("close a remote file", options.closeTimeout, () -> f.closeHandle())?
    files.filterInPlace(x -> x !== f)
    _ = f.close()
    Ok(rc)

  // The error an SFTP call on `path` answering `code` stands for: the server's own status where the
  // server refused it.
  sftpFailure(s: RawSftp, code: int, path: string, operation: string) -> SshError
    if code == sftpProtocol
      val status = int(s.lastError())
      return SftpFailed(path, status, sftpStatusWords(status))
    failure(code, s"$operation $path")

  // A new channel, for a command.
  channel() -> Result[RawChannel, SshError]
    loop
      raw.openChannel("session", 7, long(windowDefault), long(packetDefault), 0) match
        Some(ch) -> return Ok(ch)
        None ->
          val code = raw.lastErrno()
          if code != eagain then return Err(failure(code, "open a channel"))
          await("open a channel")?

  // A new `direct-tcpip` channel, to `host` at `port` as the server sees them.
  tunnel(host: string, port: int) -> Result[RawChannel, SshError]
    loop
      raw.directTcpip(host, port, "127.0.0.1", 0) match
        Some(ch) ->
          tunnels.addOne(ch)
          return Ok(ch)
        None ->
          val code = raw.lastErrno()
          if code != eagain then return Err(failure(code, s"open a tunnel to $host:$port"))
          await(s"open a tunnel to $host:$port")?

  // Closes `ch` the protocol's way, where the session can still talk, and gives it back; a command
  // whose output has not ended is sent `TERM` first, since a closed channel alone stops only a command
  // that writes. A tunnel runs no command, so it is only closed. The server's own close is not waited
  // for (see `closeSent`).
  retire(ch: RawChannel)
    val isTunnel = tunnels.exists(t -> t === ch)
    if isTunnel then tunnels.filterInPlace(t -> t !== ch)
    if !interrupted && !waiting
      if !isTunnel && ch.atEof() == 0
        _ = within("signal the command", options.closeTimeout, () -> ch.signal("TERM", 4))
      if !interrupted && !closeSent(ch) then return
    _ = ch.close()

  // Sends `ch` the protocol's close, waiting while libssh2 is still writing it, at most the options'
  // `closeTimeout`: `true` where the channel is closed, or failed, and can be given back; `false` where
  // the close is sent and libssh2 waits only for the server's, which comes once the command has exited.
  // The channel is then kept on `closing`, finished by later operations of the session as the server's
  // close arrives, and given back by the session's close in any case, so that a command that outlives
  // its channel never holds up the session.
  closeSent(ch: RawChannel) -> bool
    val deadline = monotonic() + options.closeTimeout
    loop
      if ch.sendClose() != eagain then return true
      if raw.blockDirections() & blockOutbound == 0
        closing.addOne(ch)
        return false
      if awaitUntil("close a channel", Some(deadline)).isErr then return true

  // Gives back the channels on `closing` whose server's close has arrived.
  sweep()
    if closing.isEmpty || interrupted || waiting then return
    for ch in closing.toArray()
      if ch.sendClose() != eagain
        closing.filterInPlace(c -> c !== ch)
        _ = ch.close()

  // Forgets the channel `ch`, whose command has closed it.
  forget(ch: RawChannel) = channels.filterInPlace(c -> c !== ch)

  // The methods the server offers `user`, asked once per user.
  methodsFor(user: string) -> Result[Vector[string], SshError]
    offered match
      Some((u, methods)) if u == user -> return Ok(methods)
      _ -> ()
    loop
      raw.authList(user, long(user.byteLength)) match
        Some(list) ->
          val methods = list.split(',').filter(m -> m.nonEmpty)
          offered = Some((user, methods))
          return Ok(methods)
        None ->
          if raw.authenticated() then return Ok([])
          val code = raw.lastErrno()
          if code != eagain then return Err(failure(code, "ask which logins the server takes"))
          await("ask which logins the server takes")?

  // Calls `step` until it answers anything but `EAGAIN`, waiting on the socket between, and answers
  // what it answered then.
  retrying(operation: string, step: () -> int) -> Result[int, SshError]
    loop
      val rc = step()
      if rc != eagain then return Ok(rc)
      await(operation)?

  // `retrying` for calls answering a count, reads and writes.
  retryingCount(operation: string, step: () -> long) -> Result[long, SshError]
    loop
      val rc = step()
      if rc != long(eagain) then return Ok(rc)
      await(operation)?

  // `retrying`, waiting at most `limit` in all.
  within(operation: string, limit: Duration, step: () -> int) -> Result[int, SshError]
    val deadline = monotonic() + limit
    loop
      val rc = step()
      if rc != eagain then return Ok(rc)
      awaitUntil(operation, Some(deadline))?

  // Waits, after a call answered `EAGAIN`, for the socket to be ready as libssh2 asks, at most the
  // options' `timeout`.
  await(operation: string) -> Result[unit, SshError] =
    awaitUntil(operation, options.timeout.map(d -> monotonic() + d))

  // Waits for the socket until `deadline` on the monotonic clock, where there is one, sending
  // keepalives as they fall due meanwhile: `TimedOut` where the deadline passes first, which leaves the
  // session interrupted.
  awaitUntil(operation: string, deadline: Option[Duration]) -> Result[unit, SshError]
    loop
      var limit = Duration(0)
      deadline.foreach(at -> limit = at - monotonic())
      if deadline.isDefined && limit.micros <= 0
        interrupted = true
        return Err(TimedOut(operation))
      if options.keepalive.isDefined && holdsSocket
        val (rc, next) = raw.keepaliveSend()
        if rc < 0 && rc != eagain
          interrupted = true
          return Err(failure(rc, operation))
        val due = Duration(long(if next < 1 then 1 else next) * 1000000)
        if limit.micros <= 0 || due < limit then limit = due
      waiting = true
      val ready = socket.wait(raw.blockDirections(), limit)
      waiting = false
      if ready then return Ok(())

  // Waits, with no limit, until `local` can be read where `read` says, or written where `write` says,
  // or the session's socket is ready as libssh2 last asked where `host` says: a relay's wait.
  awaitWith(operation: string, local: ByteStream, read: bool, write: bool, host: bool) -> Result[unit, SshError]
    val toHost = if !host then 0 elif raw.blockDirections() & blockOutbound != 0 then 2 else 1
    waiting = true
    socket.waitWith(local, read, write, toHost)
    waiting = false
    Ok(())

  // The error libssh2's `code` stands for, in its own words where it has them.
  failure(code: int, operation: string) -> SshError
    val (_, words) = raw.lastError(0)
    val reason = words.getOrElse("")
    errorOf(code, if reason.isEmpty then operation else reason)

  // The error a refused login answers.
  authFailure(code: int, method: string, keyPath: string) -> SshError
    if code == authenticationFailed || code == publickeyUnverified
      return AuthFailed(method, offered.map((_, m) -> m).getOrElse([]))
    if code == fileError || code == keyfileAuthFailed
      val (_, words) = raw.lastError(0)
      return KeyFile(keyPath, words.getOrElse("it cannot be read"))
    failure(code, s"log in with $method")

// The error libssh2's `code` stands for, with `reason` its words.
private errorOf(code: int, reason: string) -> SshError
  if code == timeoutError || code == socketTimeout then return TimedOut(reason)
  if code == socketDisconnect || code == socketSend || code == socketRecv || code == socketNone || code == badSocket
    return Disconnected(reason)
  if code == bannerRecv || code == bannerSend || code == kexFailure || code == keyExchangeFailure
    return Handshake(reason)
  if code == channelFailure || code == channelRequestDenied || code == requestDenied
    return ChannelRefused(reason)
  Failed(code, reason)
