// A session. It holds a descriptor of its own, `dup`ed from the connection's, which its release shuts
// down before freeing the session, so that `libssh2_session_free`, made blocking to finish its work,
// meets a socket that answers at once rather than one that could keep it waiting on the server; the
// release then closes the descriptor. A descriptor it does not yet hold, before the handshake, is the
// package's to close.
@c(
  type: "LIBSSH2_SESSION *",
  holds: "int sock = -1",
  release: "(sock >= 0 ? shutdown(sock, SHUT_RDWR) : 0, libssh2_session_set_blocking(self, 1), libssh2_session_free(self), sock >= 0 ? close(sock) : 0)"
)
private class RawSession
  @c("void libssh2_session_set_blocking(LIBSSH2_SESSION *self, int blocking)")
  setBlocking(blocking: int)

  @c("int libssh2_session_handshake(LIBSSH2_SESSION *self, libssh2_socket_t sock)", hold: "sock")
  handshake(sock: int) -> Result[unit, int]

  @c("int libssh2_session_block_directions(LIBSSH2_SESSION *self)")
  blockDirections() -> int

  @c("int libssh2_session_last_errno(LIBSSH2_SESSION *self)")
  lastErrno() -> int

  @c("int libssh2_session_last_error(LIBSSH2_SESSION *self, out char **errmsg, null int *errmsg_len, int want_buf)")
  lastError(wantBuf: int) -> (int, Option[string])

  @c("const char *libssh2_session_hostkey(LIBSSH2_SESSION *self, out size_t *len, out int *type)", view, length: "len")
  hostKey() -> (Option[ByteView], long, int)

  @c("const char *libssh2_hostkey_hash(LIBSSH2_SESSION *self, int hash_type)", view, length: "32")
  hostKeyHash(hashType: int) -> Option[ByteView]

  @c("const char *libssh2_session_banner_get(LIBSSH2_SESSION *self)")
  banner() -> Option[string]

  @c("int libssh2_session_disconnect_ex(LIBSSH2_SESSION *self, int reason, const char *description, const char *lang)")
  disconnect(reason: int, description: string, lang: string) -> int

  @c("void libssh2_keepalive_config(LIBSSH2_SESSION *self, int want_reply, unsigned int interval)")
  keepaliveConfig(wantReply: int, interval: long)

  @c("int libssh2_keepalive_send(LIBSSH2_SESSION *self, out int *seconds_to_next)")
  keepaliveSend() -> (int, int)

  @c("char *libssh2_userauth_list(LIBSSH2_SESSION *self, const char *username, unsigned int username_len)")
  authList(user: string, userLength: long) -> Option[string]

  @c("int libssh2_userauth_authenticated(LIBSSH2_SESSION *self)")
  authenticated() -> bool

  @c(
    "int libssh2_userauth_publickey_fromfile_ex(LIBSSH2_SESSION *self, const char *username, unsigned int username_len, const char *publickey, const char *privatekey, const char *passphrase)"
  )
  authKeyFile(user: string, userLength: long, publicKey: Option[string], privateKey: string, passphrase: Option[string]) -> int

  @c(
    "int libssh2_userauth_password_ex(LIBSSH2_SESSION *self, const char *username, unsigned int username_len, const char *password, unsigned int password_len, null void (*passwd_change_cb)(LIBSSH2_SESSION *session, char **newpw, int *newpw_len, void **abstract))"
  )
  authPassword(user: string, userLength: long, password: string, passwordLength: long) -> int

  @c(
    "LIBSSH2_CHANNEL *libssh2_channel_open_ex(LIBSSH2_SESSION *self, const char *channel_type, unsigned int channel_type_len, unsigned int window_size, unsigned int packet_size, null const char *message, unsigned int message_len)",
    keeps: "self"
  )
  openChannel(kind: string, kindLength: long, window: long, packet: long, messageLength: long) -> Option[RawChannel]

  @c("LIBSSH2_KNOWNHOSTS *libssh2_knownhost_init(LIBSSH2_SESSION *self)", keeps: "self")
  knownHosts() -> Option[RawKnownHosts]

  @c("LIBSSH2_AGENT *libssh2_agent_init(LIBSSH2_SESSION *self)", keeps: "self")
  agent() -> Option[RawAgent]

  @c("LIBSSH2_SFTP *libssh2_sftp_init(LIBSSH2_SESSION *self)", keeps: "self")
  sftpInit() -> Option[RawSftp]

@c(
  "LIBSSH2_SESSION *libssh2_session_init_ex(null void *(*my_alloc)(size_t count, void **abstract), null void (*my_free)(void *ptr, void **abstract), null void *(*my_realloc)(void *ptr, size_t count, void **abstract), null void *abstract)"
)
private sessionInit() -> Option[RawSession]

// A channel of a session. The package sends the protocol's close before giving the handle back, so
// that the release's `libssh2_channel_free` has nothing left to say to the server and frees it at
// once; a channel given back still open sends its close, or is freed with its session.
@c(type: "LIBSSH2_CHANNEL *", kept: "session: RawSession", release: "session ? libssh2_channel_free(self) : 0")
private class RawChannel
  @c("int libssh2_channel_handle_extended_data2(LIBSSH2_CHANNEL *self, int ignore_mode)")
  extendedData(mode: int) -> int

  @c(
    "int libssh2_channel_process_startup(LIBSSH2_CHANNEL *self, const char *request, unsigned int request_len, const char *message, unsigned int message_len)"
  )
  startup(request: string, requestLength: long, message: string, messageLength: long) -> int

  @c("ssize_t libssh2_channel_read_ex(LIBSSH2_CHANNEL *self, int stream_id, char *buf, length(buf) size_t buflen)")
  readInto(stream: int, buf: Array[byte]) -> long

  @c("ssize_t libssh2_channel_write_ex(LIBSSH2_CHANNEL *self, int stream_id, const char *buf, length(buf) size_t buflen)")
  writeFrom(stream: int, buf: Array[byte]) -> long

  @c("int libssh2_channel_send_eof(LIBSSH2_CHANNEL *self)")
  sendEof() -> int

  @c("int libssh2_channel_eof(LIBSSH2_CHANNEL *self)")
  atEof() -> int

  // Whether data for the channel has been read off the socket and waits in libssh2's queue: standard
  // output alone where `extended` is 0, standard error too where it is 1.
  @c("int libssh2_poll_channel_read(LIBSSH2_CHANNEL *self, int extended)")
  queued(extended: int) -> int

  @c("int libssh2_channel_close(LIBSSH2_CHANNEL *self)")
  sendClose() -> int

  @c("int libssh2_channel_signal_ex(LIBSSH2_CHANNEL *self, const char *signame, size_t signame_len)")
  signal(name: string, nameLength: long) -> int

  @c("int libssh2_channel_wait_closed(LIBSSH2_CHANNEL *self)")
  waitClosed() -> int

  @c("int libssh2_channel_get_exit_status(LIBSSH2_CHANNEL *self)")
  exitStatus() -> int

  @c(
    "int libssh2_channel_get_exit_signal(LIBSSH2_CHANNEL *self, out char **exitsignal, out size_t *exitsignal_len, out char **errmsg, out size_t *errmsg_len, null char **langtag, null size_t *langtag_len)",
    free: ["exitsignal: libssh2_free(session, exitsignal)", "errmsg: libssh2_free(session, errmsg)"]
  )
  exitSignal() -> Result[(Option[string], long, Option[string], long), int]

// The known hosts read from a file, to check a server's key against. Freed through its session.
@c(
  type: "LIBSSH2_KNOWNHOSTS *",
  kept: "session: RawSession",
  release: "session ? (libssh2_knownhost_free(self), 0) : 0"
)
private class RawKnownHosts
  @c("int libssh2_knownhost_readfile(LIBSSH2_KNOWNHOSTS *self, const char *filename, int type)")
  readFile(path: string, kind: int) -> int

  @c(
    "int libssh2_knownhost_checkp(LIBSSH2_KNOWNHOSTS *self, const char *host, int port, const char *key, length(key) size_t keylen, int typemask, null struct libssh2_knownhost **knownhost)"
  )
  check(host: string, port: int, key: Array[byte], typemask: int) -> int

// A connection to an SSH agent, made through a session. Talking to the agent is a local socket's
// round trip, so those calls are `blocking`.
@c(
  type: "LIBSSH2_AGENT *",
  kept: "session: RawSession",
  release: "session ? (libssh2_agent_disconnect(self), libssh2_agent_free(self), 0) : 0"
)
private class RawAgent
  @c("void libssh2_agent_set_identity_path(LIBSSH2_AGENT *self, const char *path)")
  setPath(path: string)

  @c("int libssh2_agent_connect(LIBSSH2_AGENT *self)", blocking)
  connect() -> int

  @c("int libssh2_agent_list_identities(LIBSSH2_AGENT *self)", blocking)
  listIdentities() -> int

  @c(
    "int libssh2_agent_get_identity(LIBSSH2_AGENT *self, out struct libssh2_agent_publickey **store, struct libssh2_agent_publickey *prev)",
    keeps: "self"
  )
  identity(prev: Option[AgentKey]) -> (int, Option[AgentKey])

  @c("int libssh2_agent_userauth(LIBSSH2_AGENT *self, const char *username, struct libssh2_agent_publickey *identity)", blocking)
  userauth(user: string, key: AgentKey) -> int

// One key an agent holds, which belongs to the agent's list of them and is freed with it, so giving
// the handle back frees nothing. It is valid until the list is read again or the agent is freed, so
// the package uses each only within the one call that read the list, while the agent is open.
@c(type: "struct libssh2_agent_publickey *", kept: "agent: RawAgent", release: "(void)self, (void)agent")
private class AgentKey

// The attributes of a remote file, as SFTP sends them; a field counts only where `flags` holds its bit.
@c(struct: "LIBSSH2_SFTP_ATTRIBUTES")
private data Attributes(flags: long, filesize: long, uid: long, gid: long, permissions: long, atime: long, mtime: long)

// An SFTP subsystem running on a channel of its session. Its channel belongs to the session, which
// frees it, and the SFTP state with it, when it is freed itself; `shutdown` closes it earlier, the
// protocol's way, and frees it then. So giving the handle back frees nothing: the package calls
// `shutdown` to close it and then closes the handle, which only marks it closed for its files.
@c(type: "LIBSSH2_SFTP *", kept: "session: RawSession", release: "(void)self, (void)session")
private class RawSftp
  @c("int libssh2_sftp_shutdown(LIBSSH2_SFTP *self)")
  shutdown() -> int

  @c("unsigned long libssh2_sftp_last_error(LIBSSH2_SFTP *self)")
  lastError() -> long

  @c(
    "LIBSSH2_SFTP_HANDLE *libssh2_sftp_open_ex(LIBSSH2_SFTP *self, const char *filename, unsigned int filename_len, unsigned long flags, long mode, int open_type)",
    keeps: "self"
  )
  open(path: string, pathLength: long, flags: long, mode: long, openType: int) -> Option[RawSftpFile]

  @c(
    "int libssh2_sftp_stat_ex(LIBSSH2_SFTP *self, const char *path, unsigned int path_len, int stat_type, out LIBSSH2_SFTP_ATTRIBUTES *attrs)"
  )
  stat(path: string, pathLength: long, statType: int) -> (int, Attributes)

  @c("int libssh2_sftp_mkdir_ex(LIBSSH2_SFTP *self, const char *path, unsigned int path_len, long mode)")
  mkdir(path: string, pathLength: long, mode: long) -> int

  @c("int libssh2_sftp_rmdir_ex(LIBSSH2_SFTP *self, const char *path, unsigned int path_len)")
  rmdir(path: string, pathLength: long) -> int

  @c("int libssh2_sftp_unlink_ex(LIBSSH2_SFTP *self, const char *filename, unsigned int filename_len)")
  unlink(path: string, pathLength: long) -> int

// A remote file open through SFTP. libssh2 frees it only in `libssh2_sftp_close_handle`, which talks
// to the server, so giving the handle back frees nothing: the package closes every file it opens with
// `closeHandle` (retried while it answers `EAGAIN`; any other answer has freed it) before closing the
// handle, and a file whose close could not be finished is closed by its session's close, over a
// connection cut first so that the call fails at once and frees it.
@c(type: "LIBSSH2_SFTP_HANDLE *", kept: "sftp: RawSftp", release: "(void)self, (void)sftp")
private class RawSftpFile
  @c("ssize_t libssh2_sftp_read(LIBSSH2_SFTP_HANDLE *self, char *buffer, length(buffer) size_t buffer_maxlen)")
  readInto(buffer: Array[byte]) -> long

  @c("ssize_t libssh2_sftp_write(LIBSSH2_SFTP_HANDLE *self, const char *buffer, length(buffer) size_t count)")
  writeFrom(buffer: Array[byte]) -> long

  @c("int libssh2_sftp_close_handle(LIBSSH2_SFTP_HANDLE *self)")
  closeHandle() -> int
