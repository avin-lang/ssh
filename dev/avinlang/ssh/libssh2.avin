module dev.avinlang.ssh

// libssh2's C interface as the package uses it: the bindings are the package's whole trusted surface.
// Every session runs non-blocking, so a call that would have to wait for the server answers
// `LIBSSH2_ERROR_EAGAIN` and is made again once the socket is ready; nothing here ever blocks.
//
// libssh2 counts no references. A channel, a known-hosts list and an agent belong to their session,
// and `libssh2_session_free` frees every channel still open, so each of those names its session with
// `kept:`: the session's handle is kept from the collector until theirs has been given back, and
// their release sees the session as null once it was closed, when what they would free is already
// gone with it.
import avin.c.ByteView

@c("int libssh2_init(int flags)")
private initRaw(flags: int) -> int

// libssh2's global state, made once, before the first session: `libssh2_init` is not safe to call from
// two threads at once, and a lazy value is made by one.
private lazy val initialized: int = initRaw(0)

// Makes libssh2 ready, once: zero where it is, and its error code where it could not be.
private ready() -> int = initialized

@c(const: "LIBSSH2_ERROR_EAGAIN")
private val eagain: int

@c(const: "LIBSSH2_ERROR_SOCKET_NONE")
private val socketNone: int

