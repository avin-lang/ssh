module tests

// The README's examples, against the test server, logged in through the agent `SSH_AUTH_SOCK` names,
// which `scripts/test-sshd.zsh env` points at the server's own.
import avin.fs
import avin.net.{TcpListener, TcpStream}
import avin.threads.{scope, sleep, withTimeout}
import avin.time.{millis, seconds}
import dev.avinlang.ssh.{Exited, Local, Options, Pty, Session, Signalled, SshConfig, SshError, Stderr, Stdout}

uname(
    host: string,
    user: string,
    port: int = 22,
    options: Options = Options(connectTimeout = Some(10.seconds))
) -> Result[string, SshError] =
  val session = Session.connect(host, port, options)?
  defer _ = session.close()
  session.authAgent(user)?
  val out = session.run("uname -a")?
  Ok(out.stdoutText.trim)

follow(session: Session, command: string) -> Result[int, SshError] =
  val running = session.exec(command)?
  defer _ = running.close()
  loop
    running.next()? match
      Some(Stdout(bytes)) -> print(string.fromUtf8Lossy(bytes))
      Some(Stderr(bytes)) -> print(s"! ${string.fromUtf8Lossy(bytes)}")
      None -> break
  running.wait()? match
    Exited(code) -> Ok(code)
    Signalled(signal, _) -> Ok(128)

onEach(
    hosts: Vector[string],
    user: string,
    command: string,
    port: int = 22,
    options: Options = Options()
) -> Vector[(string, string)] =
  scope(sc ->
    val threads = hosts.map(host -> sc.spawn(() ->
      val answer = withTimeout(10.seconds, _ -> runOn(host, port, user, command, options)) match
        Some(Ok(text)) -> text
        Some(Err(e)) -> s"failed: ${e.message}"
        None -> "timed out"
      (host, answer)))
    threads.map(t -> t.join()))

runOn(host: string, port: int, user: string, command: string, options: Options) -> Result[string, SshError] =
  val session = Session.connect(host, port, options)?
  defer _ = session.close()
  session.authAgent(user)?
  Ok(session.run(command)?.stdoutText)

deploy(session: Session, script: string, remote: string) -> Result[int, SshError] =
  val sftp = session.sftp()?
  defer _ = sftp.close()
  sftp.putFile(script, remote, 0o755)?
  val out = session.run(remote)?
  sftp.remove(remote)?
  Ok(if out.success then 0 else 1)

onTerminal(config: SshConfig, alias: string, command: string) -> Result[string, SshError] =
  val session = config.connect(alias)?
  defer _ = session.close()
  val running = session.exec(command, pty = Some(Pty("xterm", 120, 40)))?
  defer _ = running.close()
  val out = Buffer[byte]()
  loop
    running.next()? match
      Some(Stdout(bytes)) -> out.addAll(bytes)
      Some(_) -> ()
      None -> break
  Ok(string.fromUtf8Lossy(out.toArray()))

forward(session: Session, localPort: int, host: string, port: int) -> Result[unit, SshError] =
  val listener = TcpListener.bind("127.0.0.1", localPort).mapErr(e -> Local(e))?
  defer _ = listener.close()
  loop
    val conn = listener.accept().mapErr(e -> Local(e))?
    val tunnel = session.tunnel(host, port)?
    _ = tunnel.relay(conn)?
    _ = tunnel.close()
    _ = conn.close()

@test("the README's fifth example: a command on a terminal, on a host named in the configuration")
readmeOnTerminal()
  if server() is Some((dir, port, user))
    val config = serverConfig(dir, port, user, s"Host web\n  HostName localhost\n  Port $port\n  ProxyJump testbox")
    val text = made(onTerminal(config, "web", "stty size; tty"))
    assert(text.contains("40 120"))
    assert(text.contains("/dev/"))

@test("the README's sixth example: a local port forwarded, one connection after another")
readmeForward()
  if server() is Some((dir, port, user))
    scope(sc -> withEcho(sc, echo ->
      val localPort = closedPort()
      _ = sc.spawn(() ->
        val s = loggedIn(dir, port, user)
        _ = forward(s, localPort, "127.0.0.1", echo)
        _ = s.close()
        ())
      for round in 0 ..< 3
        var conn = TcpStream.connect("127.0.0.1", localPort)
        // The forwarder may not be listening yet.
        var tries = 0
        while conn.isErr && tries < 100
          sleep(millis(20))
          conn = TcpStream.connect("127.0.0.1", localPort)
          tries += 1
        val c = net(conn)
        net(c.writeText(s"round $round"))
        net(c.shutdownOutput())
        assertEq(string.fromUtf8Lossy(net(c.readAll())), s"round $round")
        _ = c.close()))

@test("the README's fourth example: a script uploaded, run and removed")
readmeDeploy()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val t = scratch()
    defer _ = t.close()
    local(fs.writeText(s"${t.path}/ok.sh", "#!/bin/sh\nexit 0\n"))
    local(fs.writeText(s"${t.path}/bad.sh", "#!/bin/sh\nexit 3\n"))
    assertEq(made(deploy(s, s"${t.path}/ok.sh", s"${t.path}/run-ok")), 0)
    assertEq(made(deploy(s, s"${t.path}/bad.sh", s"${t.path}/run-bad")), 1)
    assert(!fs.exists(s"${t.path}/run-ok"))

@test("the README's first example: uname on a host, logged in with the agent")
readmeUname()
  if server() is Some((dir, port, user))
    val text = made(uname("127.0.0.1", user, port, testOptions(dir) with {connectTimeout = Some(10.seconds)}))
    assert(text.nonEmpty)

@test("the README's second example: output followed as it arrives, and the exit code")
readmeFollow()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    assertEq(made(follow(s, "echo out; echo err >&2; exit 5")), 5)
    assertEq(made(follow(s, "kill -TERM $$")), 128)

@test("the README's third example: one command on several hosts at once, a host that fails among them")
readmeOnEach()
  if server() is Some((dir, port, user))
    val answers = onEach(["127.0.0.1", "localhost", "127.0.0.1"], user, "echo hi", port, testOptions(dir))
    assertEq(answers.length, 3)
    for (_, a) in answers do assertEq(a, "hi\n")
    // A host the server does not listen on fails on its own, the others unaffected.
    val mixed = onEach(["127.0.0.1", "::1"], user, "echo hi", port, testOptions(dir))
    assertEq(mixed(0), ("127.0.0.1", "hi\n"))
    assert(mixed(1).1.startsWith("failed: "))
