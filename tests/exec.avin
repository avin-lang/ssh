module tests

// Running commands: output streamed as it arrives and collected under a limit, exit codes and
// signals, standard input, several commands on one session, a deadline in the middle of a command,
// and the session closed under a command.
import avin.threads.withTimeout
import avin.time.{millis, monotonic, seconds}
import dev.avinlang.ssh.{
  Closed, Discard, Exited, Interrupted, Invalid, Merge, Signalled, Stderr, Stdout, TimedOut, Options, Session
}

// Everything `e` prints, standard output and standard error apart, read to the end.
drained(e: dev.avinlang.ssh.Exec) -> (string, string)
  val out = Buffer[byte]()
  val err = Buffer[byte]()
  loop
    made(e.next()) match
      Some(Stdout(b)) -> out.addAll(b)
      Some(Stderr(b)) -> err.addAll(b)
      None -> break
  (string.fromUtf8Lossy(out.toArray()), string.fromUtf8Lossy(err.toArray()))

@test("a command's output and exit status")
echo()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val o = made(s.run("echo hello"))
    assertEq(o.stdoutText, "hello\n")
    assertEq(o.stderrText, "")
    assert(o.status is Exited(0))
    assert(o.success)
    assert(!o.truncated)

@test("a command with no output answers empty output")
noOutput()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val o = made(s.run("true"))
    assertEq(o.stdout.length, 0)
    assertEq(o.stderr.length, 0)
    assert(o.success)

@test("a command the shell cannot find exits 127, saying so on standard error")
notFound()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val o = made(s.run("no-such-command-anywhere"))
    assert(o.status is Exited(127))
    assert(!o.success)
    assert(o.stderrText.contains("no-such-command-anywhere"))

@test("a non-zero exit is the code, not an error")
nonZero()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    assert(made(s.run("exit 3")).status is Exited(3))
    assert(made(s.run("exit 255")).status is Exited(255))
    // The session goes on after a failing command.
    assert(made(s.run("exit 0")).success)

@test("a command a signal ends is Signalled with the signal's name")
signalled()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    made(s.run("kill -TERM $$")).status match
      Signalled(name, _) -> assertEq(name, "TERM")
      other -> fail(s"expected Signalled, got $other")
    assert(made(s.run("kill -KILL $$")).status is Signalled("KILL", _))

@test("standard output and standard error come apart, each in its order")
interleaved()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val e = made(s.exec("for i in 1 2 3 4 5; do echo out$i; echo err$i >&2; done"))
    defer _ = e.close()
    val (out, err) = drained(e)
    assertEq(out, "out1\nout2\nout3\nout4\nout5\n")
    assertEq(err, "err1\nerr2\nerr3\nerr4\nerr5\n")
    assert(made(e.wait()).success)

@test("Merge reads standard error as standard output, Discard drops it")
stderrModes()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val merged = made(s.exec("echo a; echo b >&2; echo c", Merge))
    val (out, err) = drained(merged)
    assertEq(err, "")
    assert(out.contains("a\n"))
    assert(out.contains("b\n"))
    assert(out.contains("c\n"))
    _ = merged.close()
    val dropped = made(s.exec("echo a; echo b >&2; echo c", Discard))
    assertEq(drained(dropped), ("a\nc\n", ""))
    _ = dropped.close()

@test("ten megabytes stream through in chunks, none larger than one read")
largeOutput()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val e = made(s.exec("head -c 10485760 /dev/zero"))
    defer _ = e.close()
    var total: long = 0
    var largest = 0
    var chunks = 0
    loop
      made(e.next()) match
        Some(Stdout(b)) ->
          total += long(b.length)
          if b.length > largest then largest = b.length
          chunks += 1
        Some(Stderr(_)) -> fail("nothing was written to standard error")
        None -> break
    assertEq(total, long(10485760))
    assert(largest <= 32768)
    assert(chunks >= 320)
    assert(made(e.wait()).success)

@test("run keeps at most its limit of each stream, reads the rest and says it truncated")
runLimit()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val o = made(s.run("head -c 10485760 /dev/zero; head -c 100 /dev/zero >&2", 1048576))
    assertEq(o.stdout.length, 1048576)
    assertEq(o.stderr.length, 100)
    assert(o.truncated)
    assert(o.success)
    // Exactly at the limit is not truncated; a limit of zero keeps nothing.
    val exact = made(s.run("printf 12345", 5))
    assertEq(exact.stdoutText, "12345")
    assert(!exact.truncated)
    val none = made(s.run("printf 12345", 0))
    assertEq(none.stdout.length, 0)
    assert(none.truncated)
    assert(failure(s.run("true", -1)) is Invalid(_))

@test("standard input reaches the command, and closing it ends cat")
stdinToCat()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val e = made(s.exec("cat"))
    defer _ = e.close()
    made(e.stdin("line one\n".utf8))
    assert(e.write("line two\n".utf8).isOk)
    made(e.stdin(Array.empty[byte]()))
    made(e.closeStdin())
    made(e.closeStdin())
    assertEq(drained(e), ("line one\nline two\n", ""))
    assert(made(e.wait()).success)
    assert(failure(e.stdin("late".utf8)) is Invalid(_))

@test("a megabyte of standard input comes back through cat, read as it is written")
largeStdin()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val e = made(s.exec("wc -c"))
    defer _ = e.close()
    val piece = Array.fill(65536, byte(int('x')))
    for _ in 0 ..< 16 do made(e.stdin(piece))
    made(e.closeStdin())
    val (out, _) = drained(e)
    assertEq(out.trim, "1048576")

@test("several commands run on one session at once, each read in turn")
severalAtOnce()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val running = Buffer[dev.avinlang.ssh.Exec]()
    for i in 0 ..< 5
      running.addOne(made(s.exec(s"sleep 0.2; echo command$i")))
    // Read last first: the earlier commands' output waits in libssh2 meanwhile.
    var i = 4
    while i >= 0
      assertEq(drained(running(i)), (s"command$i\n", ""))
      assert(made(running(i).wait()).success)
      _ = running(i).close()
      i -= 1

@test("wait reads what is left and answers the same status when asked again")
waitTwice()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val e = made(s.exec("echo unread; exit 4"))
    assert(made(e.wait()) is Exited(4))
    assert(made(e.wait()) is Exited(4))
    _ = e.close()

@test("a deadline in the middle of a command stops it, and leaves the session Interrupted")
deadlineMidExec()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    val began = monotonic()
    assertEq(withTimeout(millis(300), _ -> s.run("sleep 10").isOk), None)
    assert(monotonic() - began < seconds(3))
    assert(!s.isOpen)
    assert(failure(s.run("true")) is Interrupted)
    val closing = monotonic()
    assert(s.close().isOk)
    assert(monotonic() - closing < seconds(2))

@test("the session's timeout ends a wait with TimedOut, which leaves it Interrupted")
sessionTimeout()
  if server() is Some((dir, port, user))
    val s = made(Session.connect("127.0.0.1", port, testOptions(dir) with {timeout = Some(millis(300))}))
    made(s.authKey(user, s"$dir/client"))
    assert(failure(s.run("sleep 10")) is TimedOut(_))
    assert(failure(s.run("true")) is Interrupted)
    assert(s.close().isOk)

@test("closing the session under a running command closes it, and the command answers Closed")
closeMidCommand()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    val e = made(s.exec("sleep 30"))
    val began = monotonic()
    assert(s.close().isOk)
    assert(monotonic() - began < seconds(6))
    assert(!e.isOpen)
    assert(failure(e.next()) is Closed)
    assert(failure(e.wait()) is Closed)
    assert(failure(e.stdin("x".utf8)) is Closed)
    assert(failure(e.closeStdin()) is Closed)
    assert(e.close().isOk)

@test("closing a command mid-run ends it, and the session runs the next")
closeCommand()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val e = made(s.exec("sleep 30"))
    val began = monotonic()
    assert(e.close().isOk)
    assert(e.close().isOk)
    assert(monotonic() - began < seconds(6))
    assert(failure(e.next()) is Closed)
    assertEq(made(s.run("echo next")).stdoutText, "next\n")

@test("a command holding U+0000 is Invalid, and the session goes on")
nulCommand()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    assert(failure(s.exec("echo a\u0000b")) is Invalid(_))
    assert(made(s.run("true")).success)

@test("a command run before logging in is refused")
beforeLogin()
  if server() is Some((dir, port, _))
    val s = connected(dir, port)
    defer _ = s.close()
    assert(s.run("true").isErr)

@test("output that is not UTF-8 reads as replacement characters in text, the bytes kept as they are")
binaryOutput()
  if server() is Some((dir, port, user))
    val s = loggedIn(dir, port, user)
    defer _ = s.close()
    val o = made(s.run("printf '\\377\\000a'"))
    assertEq(o.stdout.length, 3)
    assertEq(o.stdout(0), byte(255))
    assertEq(o.stdout(1), byte(0))
    assert(o.stdoutText.contains("a"))
